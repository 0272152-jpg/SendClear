# Copy to .env and fill in. NEVER commit .env.
# Password and PIN for the two seeded demo accounts (Ana 5550000001, Beto 5550000002).
# Give the real values to the professor only in the Blackboard submission.
EXPO_PUBLIC_DEMO_PASSWORD=
EXPO_PUBLIC_DEMO_PIN=

# Optional presenter account, created on every phone (even one that already has data).
# Leave empty to skip. Password 8+ characters, PIN 4 digits, phone 10 digits.
EXPO_PUBLIC_EXTRA_NAME=
EXPO_PUBLIC_EXTRA_PHONE=
EXPO_PUBLIC_EXTRA_PASSWORD=
EXPO_PUBLIC_EXTRA_PIN=
